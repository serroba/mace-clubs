project.manifest = manifest.xml
base.sourcePath = source
# The one build that compiles MaceClubsApp's memory probe in, for
# tools/memory-headroom.ts. Everything else in the repo excludes
# `memoryProbe` and keeps the no-op twin, so two println calls never reach a
# watch. Run via `make memory-headroom`, not by hand.
#
# The device-specific lines exist for the same reason they do in
# monkey.jungle: the five 96KB watches ship a reduced build, and measuring
# the full one there would report headroom no owner has.
BASE_EXCLUDES = offscreenRender;swingTuning
base.excludeAnnotations = $(BASE_EXCLUDES);noMemoryProbe;noSwingDebug;noHistory;noCustomWorkout;noMotionExport;noMenuLabelPrefix;noLauncherIcon;noSetChart
descentg1.excludeAnnotations = $(BASE_EXCLUDES);noMemoryProbe;swingDebug;history;customWorkout;motionExport;menuLabelPrefix;launcherIcon;setChart
instinct2.excludeAnnotations = $(BASE_EXCLUDES);noMemoryProbe;swingDebug;history;customWorkout;motionExport;menuLabelPrefix;launcherIcon;setChart
instinct2s.excludeAnnotations = $(BASE_EXCLUDES);noMemoryProbe;swingDebug;history;customWorkout;motionExport;menuLabelPrefix;launcherIcon;setChart
instinct2x.excludeAnnotations = $(BASE_EXCLUDES);noMemoryProbe;swingDebug;history;customWorkout;motionExport;menuLabelPrefix;launcherIcon;setChart
instinctcrossover.excludeAnnotations = $(BASE_EXCLUDES);noMemoryProbe;swingDebug;history;customWorkout;motionExport;menuLabelPrefix;launcherIcon;setChart
