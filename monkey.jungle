project.manifest = manifest.xml
base.sourcePath = source
# The Linux simulator cannot draw device fonts offscreen; CI compiles the
# no-op render(). Local test builds use monkey.local.jungle instead.
base.excludeAnnotations = offscreenRender
# fenix5 (API 3.1, our oldest supported level) fails Activity.SPORT_TRAINING
# at runtime even though it compiles fine - a pre-existing gap unrelated to
# the live-session smoke test, which every other CI device runs fine.
fenix5.excludeAnnotations = offscreenRender;liveSessionSmoke
