project.manifest = manifest.xml
base.sourcePath = source
# The Linux simulator cannot draw device fonts offscreen; CI compiles the
# no-op render(). Local test builds use monkey.local.jungle instead.
# swingTuning is SwingTuningSearch.mc's grid search: too slow for routine
# runs, opt-in only via `make tuning-search` (monkey.tuning.jungle).
# testFont is AppFont.mc's bundled bitmap-font substitute, only compiled by
# monkey.e2e.jungle (tools/e2e/testfont/README.md) - real builds always use
# actual device fonts.
base.excludeAnnotations = offscreenRender;swingTuning;testFont
# fenix5 (API 3.1, our oldest supported level) fails Activity.SPORT_TRAINING
# at runtime even though it compiles fine - a pre-existing gap unrelated to
# the live-session smoke test, which every other CI device runs fine.
fenix5.excludeAnnotations = offscreenRender;liveSessionSmoke;swingTuning;testFont
